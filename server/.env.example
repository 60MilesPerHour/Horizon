# Required. No default — the app refuses to start without it.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=

# The Ollama rig. Reached server-side only; never sent to a browser.
OLLAMA_URL=http://172.16.23.20:11434
# Needed for :cloud models. Also never sent to a browser.
OLLAMA_TOKEN=

DATABASE_PATH=/data/horizon-web.db

# First run only, and only while the users table is empty.
BOOTSTRAP_ADMIN_USERNAME=miles
BOOTSTRAP_ADMIN_PASSWORD=

# Set false ONLY for local plain-HTTP development. Behind the Cloudflare
# tunnel this must stay true or the session cookie travels in the clear.
SECURE_COOKIES=true
